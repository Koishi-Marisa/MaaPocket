# 统一换行：仓库内一律 LF，避免 Windows 检出把 gradlew / shell / python 脚本改成 CRLF。
* text=auto eol=lf

# 必须在任何平台上保持 LF 的可执行/脚本文件
gradlew                text eol=lf
*.sh                   text eol=lf
*.bash                 text eol=lf
*.py                   text eol=lf
.gradle*               text eol=lf

# Android / Kotlin / Gradle
*.kt                   text eol=lf
*.kts                  text eol=lf
*.java                 text eol=lf
*.aidl                 text eol=lf
*.xml                  text eol=lf
*.json                 text eol=lf
*.toml                 text eol=lf
*.properties           text eol=lf
*.yml                  text eol=lf
*.yaml                 text eol=lf
*.md                   text eol=lf

# 二进制
*.png                  binary
*.jpg                  binary
*.jpeg                 binary
*.webp                 binary
*.ico                  binary
*.jar                  binary
*.so                   binary
*.aar                  binary
*.zip                  binary
*.gz                   binary
