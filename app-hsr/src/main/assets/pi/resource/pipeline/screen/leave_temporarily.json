{
  "Screen_leave_temporarily": {
    "recognition": "TemplateMatch",
    "template": "screen/universe/leave_temporarily.png",
    "threshold": 0.8,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "DoNothing",
    "next": [],
    "attach": {
      "march7th:kind": "screen-anchor",
      "march7th:screen_id": "leave_temporarily",
      "march7th:screen_name": "退出「模拟宇宙」",
      "march7th:source_image_path": "./assets/images/screen/universe/leave_temporarily.png",
      "march7th:note": "模板是 1920x1080 PC 客户端截图的小块裁剪，手机上必须重新采集，见 RECAPTURE.md"
    }
  },
  "leave_temporarily__main__0": {
    "recognition": "TemplateMatch",
    "template": "screen/universe/leave_temporarily.png",
    "threshold": 0.9,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "Click",
    "target": true,
    "next": [
      "leave_temporarily__main__1"
    ],
    "attach": {
      "march7th:edge": [
        "leave_temporarily",
        "main"
      ],
      "march7th:edge_index": 0,
      "march7th:action_index": 0,
      "march7th:expression": "auto.click_element('./assets/images/screen/universe/leave_temporarily.png', 'image', 0.9)",
      "march7th:kind": "click-image",
      "march7th:upstream_threshold": 0.9,
      "march7th:masked_template": false
    }
  },
  "leave_temporarily__main__1": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "post_delay": 1000,
    "next": [
      "Screen_main"
    ],
    "attach": {
      "march7th:edge": [
        "leave_temporarily",
        "main"
      ],
      "march7th:edge_index": 0,
      "march7th:action_index": 1,
      "march7th:expression": "time.sleep(1)",
      "march7th:kind": "sleep"
    }
  },
  "Nav_leave_temporarily_from_universe_map": {
    "recognition": "TemplateMatch",
    "template": "screen/universe/universe_map.png",
    "threshold": 0.8,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "DoNothing",
    "next": [
      "universe_map__leave_temporarily__0"
    ],
    "attach": {
      "march7th:kind": "nav-guard",
      "march7th:note": "在 universe_map 上时，沿上游第一条 universe_map -> leave_temporarily 边前进"
    }
  },
  "NavTo_leave_temporarily": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "next": [
      "Nav_leave_temporarily_from_universe_map",
      "Screen_leave_temporarily",
      "NavTo_universe_map"
    ],
    "attach": {
      "march7th:kind": "nav-router",
      "march7th:target_screen": "leave_temporarily",
      "march7th:predecessors": [
        "universe_map"
      ],
      "march7th:routed_predecessors": [
        "universe_map"
      ],
      "march7th:note": "DirectHit 进入：先按顺序试探各前驱屏幕守卫节点（TemplateMatch 前驱屏幕锚点），命中则沿那条上游边导航；全部未命中则回退到 Screen_leave_temporarily 锚点——若此时已经在 leave_temporarily 上即成功，否则本节点识别失败（诚实失败，不静默跳过）。只覆盖单跳。"
    }
  }
}
