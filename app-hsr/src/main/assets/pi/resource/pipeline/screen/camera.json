{
  "Screen_camera": {
    "recognition": "TemplateMatch",
    "template": "screen/camera.png",
    "threshold": 0.8,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "DoNothing",
    "next": [],
    "attach": {
      "march7th:kind": "screen-anchor",
      "march7th:screen_id": "camera",
      "march7th:screen_name": "相机",
      "march7th:source_image_path": "./assets/images/screen/camera.png",
      "march7th:note": "模板是 1920x1080 PC 客户端截图的小块裁剪，手机上必须重新采集，见 RECAPTURE.md"
    }
  },
  "camera__main__0": {
    "recognition": "DirectHit",
    "action": "ClickKey",
    "key": 111,
    "next": [
      "Screen_main"
    ],
    "attach": {
      "march7th:edge": [
        "camera",
        "main"
      ],
      "march7th:edge_index": 0,
      "march7th:action_index": 0,
      "march7th:expression": "auto.press_key('esc')",
      "march7th:kind": "press_key",
      "march7th:upstream_key": "esc",
      "march7th:android_keycode": 111
    }
  },
  "Nav_camera_from_menu": {
    "recognition": "TemplateMatch",
    "template": "share/menu/more.png",
    "threshold": 0.8,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "DoNothing",
    "next": [
      "menu__camera__0"
    ],
    "attach": {
      "march7th:kind": "nav-guard",
      "march7th:note": "在 menu 上时，沿上游第一条 menu -> camera 边前进"
    }
  },
  "Nav_camera_from_photo_preview": {
    "recognition": "TemplateMatch",
    "template": "screen/photo_preview.png",
    "threshold": 0.8,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "DoNothing",
    "next": [
      "photo_preview__camera__0"
    ],
    "attach": {
      "march7th:kind": "nav-guard",
      "march7th:note": "在 photo_preview 上时，沿上游第一条 photo_preview -> camera 边前进"
    }
  },
  "NavTo_camera": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "next": [
      "Nav_camera_from_menu",
      "Nav_camera_from_photo_preview",
      "Screen_camera"
    ],
    "attach": {
      "march7th:kind": "nav-router",
      "march7th:target_screen": "camera",
      "march7th:predecessors": [
        "menu",
        "photo_preview"
      ],
      "march7th:routed_predecessors": [
        "menu",
        "photo_preview"
      ],
      "march7th:note": "DirectHit 进入：先按顺序试探各前驱屏幕守卫节点（TemplateMatch 前驱屏幕锚点），命中则沿那条上游边导航；全部未命中则回退到 Screen_camera 锚点——若此时已经在 camera 上即成功，否则本节点识别失败（诚实失败，不静默跳过）。只覆盖单跳。"
    }
  }
}
