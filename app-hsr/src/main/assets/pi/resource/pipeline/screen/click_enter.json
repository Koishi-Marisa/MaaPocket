{
  "Screen_click_enter": {
    "recognition": "TemplateMatch",
    "template": "screen/click_enter.png",
    "threshold": 0.8,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "DoNothing",
    "next": [],
    "attach": {
      "march7th:kind": "screen-anchor",
      "march7th:screen_id": "click_enter",
      "march7th:screen_name": "点击进入",
      "march7th:source_image_path": "./assets/images/screen/click_enter.png",
      "march7th:note": "模板是 1920x1080 PC 客户端截图的小块裁剪，手机上必须重新采集，见 RECAPTURE.md"
    }
  },
  "click_enter__main__0": {
    "recognition": "TemplateMatch",
    "template": "screen/click_enter.png",
    "threshold": 0.9,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "Click",
    "target": true,
    "next": [
      "click_enter__main__1"
    ],
    "attach": {
      "march7th:edge": [
        "click_enter",
        "main"
      ],
      "march7th:edge_index": 0,
      "march7th:action_index": 0,
      "march7th:expression": "auto.click_element('./assets/images/screen/click_enter.png', 'image', 0.9)",
      "march7th:kind": "click-image",
      "march7th:upstream_threshold": 0.9,
      "march7th:masked_template": false
    }
  },
  "click_enter__main__1": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "post_delay": 6000,
    "next": [
      "Screen_main"
    ],
    "attach": {
      "march7th:edge": [
        "click_enter",
        "main"
      ],
      "march7th:edge_index": 0,
      "march7th:action_index": 1,
      "march7th:expression": "time.sleep(6)",
      "march7th:kind": "sleep"
    }
  },
  "Nav_click_enter_from_enter_cloud_game": {
    "recognition": "TemplateMatch",
    "template": "screen/cloud/enter_cloud_game.png",
    "threshold": 0.8,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "DoNothing",
    "next": [
      "enter_cloud_game__click_enter__0"
    ],
    "attach": {
      "march7th:kind": "nav-guard",
      "march7th:note": "在 enter_cloud_game 上时，沿上游第一条 enter_cloud_game -> click_enter 边前进"
    }
  },
  "Nav_click_enter_from_start_game": {
    "recognition": "TemplateMatch",
    "template": "screen/start_game.png",
    "threshold": 0.8,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "DoNothing",
    "next": [
      "start_game__click_enter__0"
    ],
    "attach": {
      "march7th:kind": "nav-guard",
      "march7th:note": "在 start_game 上时，沿上游第一条 start_game -> click_enter 边前进"
    }
  },
  "NavTo_click_enter": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "next": [
      "Nav_click_enter_from_enter_cloud_game",
      "Nav_click_enter_from_start_game",
      "Screen_click_enter"
    ],
    "attach": {
      "march7th:kind": "nav-router",
      "march7th:target_screen": "click_enter",
      "march7th:predecessors": [
        "enter_cloud_game",
        "start_game"
      ],
      "march7th:note": "DirectHit 进入：先按顺序试探各前驱屏幕守卫节点（TemplateMatch 前驱屏幕锚点），命中则沿那条上游边导航；全部未命中则回退到 Screen_click_enter 锚点——若此时已经在 click_enter 上即成功，否则本节点识别失败（诚实失败，不静默跳过）。只覆盖单跳。"
    }
  }
}
