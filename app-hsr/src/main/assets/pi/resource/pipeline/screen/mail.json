{
  "Screen_mail": {
    "recognition": "TemplateMatch",
    "template": "screen/mail.png",
    "threshold": 0.8,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "DoNothing",
    "next": [],
    "attach": {
      "march7th:kind": "screen-anchor",
      "march7th:screen_id": "mail",
      "march7th:screen_name": "邮箱",
      "march7th:source_image_path": "./assets/images/screen/mail.png",
      "march7th:note": "模板是 1920x1080 PC 客户端截图的小块裁剪，手机上必须重新采集，见 RECAPTURE.md"
    }
  },
  "mail__menu__0": {
    "recognition": "DirectHit",
    "action": "ClickKey",
    "key": 111,
    "next": [
      "Screen_menu"
    ],
    "attach": {
      "march7th:edge": [
        "mail",
        "menu"
      ],
      "march7th:edge_index": 0,
      "march7th:action_index": 0,
      "march7th:expression": "auto.press_key('esc')",
      "march7th:kind": "press_key",
      "march7th:upstream_key": "esc",
      "march7th:android_keycode": 111
    }
  },
  "Nav_mail_from_menu": {
    "recognition": "TemplateMatch",
    "template": "share/menu/more.png",
    "threshold": 0.8,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "DoNothing",
    "next": [
      "menu__mail__0"
    ],
    "attach": {
      "march7th:kind": "nav-guard",
      "march7th:note": "在 menu 上时，沿上游第一条 menu -> mail 边前进"
    }
  },
  "NavTo_mail": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "next": [
      "Nav_mail_from_menu",
      "Screen_mail"
    ],
    "attach": {
      "march7th:kind": "nav-router",
      "march7th:target_screen": "mail",
      "march7th:predecessors": [
        "menu"
      ],
      "march7th:note": "DirectHit 进入：先按顺序试探各前驱屏幕守卫节点（TemplateMatch 前驱屏幕锚点），命中则沿那条上游边导航；全部未命中则回退到 Screen_mail 锚点——若此时已经在 mail 上即成功，否则本节点识别失败（诚实失败，不静默跳过）。只覆盖单跳。"
    }
  }
}
