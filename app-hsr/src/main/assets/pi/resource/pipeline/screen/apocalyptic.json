{
  "Screen_apocalyptic": {
    "recognition": "TemplateMatch",
    "template": "screen/apocalyptic/apocalyptic.png",
    "threshold": 0.8,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "DoNothing",
    "next": [],
    "attach": {
      "march7th:kind": "screen-anchor",
      "march7th:screen_id": "apocalyptic",
      "march7th:screen_name": "末日幻影",
      "march7th:source_image_path": "./assets/images/screen/apocalyptic/apocalyptic.png",
      "march7th:note": "模板是 1920x1080 PC 客户端截图的小块裁剪，手机上必须重新采集，见 RECAPTURE.md"
    }
  },
  "apocalyptic__main__0": {
    "recognition": "DirectHit",
    "action": "ClickKey",
    "key": 111,
    "next": [
      "Screen_main"
    ],
    "attach": {
      "march7th:edge": [
        "apocalyptic",
        "main"
      ],
      "march7th:edge_index": 0,
      "march7th:action_index": 0,
      "march7th:expression": "auto.press_key('esc')",
      "march7th:kind": "press_key",
      "march7th:upstream_key": "esc",
      "march7th:android_keycode": 111
    }
  },
  "Nav_apocalyptic_from_guide4": {
    "recognition": "TemplateMatch",
    "template": "screen/guide/guide4.png",
    "threshold": 0.8,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "DoNothing",
    "next": [
      "guide4__apocalyptic__0__UNMAPPED_7"
    ],
    "attach": {
      "march7th:kind": "nav-guard",
      "march7th:note": "在 guide4 上时，沿上游第一条 guide4 -> apocalyptic 边前进"
    }
  },
  "NavTo_apocalyptic": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "next": [
      "Nav_apocalyptic_from_guide4",
      "Screen_apocalyptic"
    ],
    "attach": {
      "march7th:kind": "nav-router",
      "march7th:target_screen": "apocalyptic",
      "march7th:predecessors": [
        "guide4"
      ],
      "march7th:routed_predecessors": [
        "guide4"
      ],
      "march7th:note": "DirectHit 进入：先按顺序试探各前驱屏幕守卫节点（TemplateMatch 前驱屏幕锚点），命中则沿那条上游边导航；全部未命中则回退到 Screen_apocalyptic 锚点——若此时已经在 apocalyptic 上即成功，否则本节点识别失败（诚实失败，不静默跳过）。只覆盖单跳。"
    }
  }
}
