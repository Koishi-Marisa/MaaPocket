      0
    ],
    "action": "DoNothing",
    "next": [],
    "attach": {
      "march7th:kind": "screen-anchor",
      "march7th:screen_id": "divergent_mode_select_cycle",
      "march7th:screen_name": "差分宇宙-周期演算",
      "march7th:source_image_path": [
        "./assets/images/screen/universe/mode_select_cycle.png",
        "./assets/images/screen/universe/mode_select_cycle2.png"
      ],
      "march7th:note": "模板是 1920x1080 PC 客户端截图的小块裁剪，手机上必须重新采集，见 RECAPTURE.md"
