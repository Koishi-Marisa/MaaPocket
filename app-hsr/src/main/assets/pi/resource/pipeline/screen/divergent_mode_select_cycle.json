  "divergent_mode_select_cycle__divergent_mode_select__0": {
    "recognition": "DirectHit",
    "action": "ClickKey",
    "key": 111,
    "next": [
      "Screen_divergent_mode_select"
    ],
    "attach": {
      "march7th:edge": [
        "divergent_mode_select_cycle",
        "divergent_mode_select"
      ],
      "march7th:edge_index": 0,
      "march7th:action_index": 0,
      "march7th:expression": "auto.press_key('esc')",
      "march7th:kind": "press_key",
      "march7th:upstream_key": "esc",
      "march7th:android_keycode": 111,
      "march7th:recapture_note": "上游按 esc 打开/关闭暂停菜单（49 次中的 48 次）。Android 客户端没有键盘，esc 不会到达游戏；手机上应改为 Android KEYCODE_BACK(4)，即把 key 由 111 改成 4，或改成点击屏幕上的返回/暂停按钮的模板匹配节点。"
    }
  },
  "Nav_divergent_mode_select_cycle_from_divergent_mode_select": {
    "recognition": "TemplateMatch",
    "template": "screen/universe/divergent_mode_select.png",
    "threshold": 0.8,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "DoNothing",
    "next": [
      "divergent_mode_select__divergent_mode_select_cycle__0__UNMAPPED_16"
    ],
    "attach": {
      "march7th:kind": "nav-guard",
      "march7th:note": "在 divergent_mode_select 上时，沿上游第一条 divergent_mode_select -> divergent_mode_select_cycle 边前进"
    }
  },
  "NavTo_divergent_mode_select_cycle": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "next": [
      "Screen_divergent_mode_select_cycle",
      "Nav_divergent_mode_select_cycle_from_divergent_mode_select",
      "NavTo_divergent_mode_select"
    ],
    "attach": {
      "march7th:kind": "nav-router",
      "march7th:target_screen": "divergent_mode_select_cycle",
      "march7th:predecessors": [
        "divergent_mode_select"
      ],
      "march7th:routed_predecessors": [
        "divergent_mode_select"
      ],
      "march7th:note": "DirectHit 进入：先按顺序试探各前驱屏幕守卫节点（TemplateMatch 前驱屏幕锚点），命中则沿那条上游边导航；全部未命中则回退到 Screen_divergent_mode_select_cycle 锚点——若此时已经在 divergent_mode_select_cycle 上即成功，否则本节点识别失败（诚实失败，不静默跳过）。只覆盖单跳。"
    }
  }
}
