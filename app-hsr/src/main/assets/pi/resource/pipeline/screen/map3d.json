{
  "Screen_map3d": {
    "recognition": "TemplateMatch",
    "template": "screen/map3d.png",
    "threshold": 0.8,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "DoNothing",
    "next": [],
    "attach": {
      "march7th:kind": "screen-anchor",
      "march7th:screen_id": "map3d",
      "march7th:screen_name": "3D地图",
      "march7th:source_image_path": "./assets/images/screen/map3d.png",
      "march7th:note": "模板是 1920x1080 PC 客户端截图的小块裁剪，手机上必须重新采集，见 RECAPTURE.md"
    }
  },
  "map3d__map__0": {
    "recognition": "TemplateMatch",
    "template": "share/map/back.png",
    "threshold": 0.9,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "Click",
    "target": true,
    "next": [
      "Screen_map"
    ],
    "attach": {
      "march7th:edge": [
        "map3d",
        "map"
      ],
      "march7th:edge_index": 0,
      "march7th:action_index": 0,
      "march7th:expression": "auto.click_element('./assets/images/share/map/back.png', 'image', 0.9)",
      "march7th:kind": "click-image",
      "march7th:upstream_threshold": 0.9,
      "march7th:masked_template": false
    }
  },
  "NavTo_map3d": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "next": [
      "Screen_map3d"
    ],
    "attach": {
      "march7th:kind": "nav-router",
      "march7th:target_screen": "map3d",
      "march7th:predecessors": [],
      "march7th:note": "DirectHit 进入：先按顺序试探各前驱屏幕守卫节点（TemplateMatch 前驱屏幕锚点），命中则沿那条上游边导航；全部未命中则回退到 Screen_map3d 锚点——若此时已经在 map3d 上即成功，否则本节点识别失败（诚实失败，不静默跳过）。只覆盖单跳。"
    }
  }
}
