    "next": [],
    "attach": {
      "march7th:kind": "screen-anchor",
      "march7th:screen_id": "prepare_fight",
      "march7th:screen_name": "忘却之庭-准备战斗",
      "march7th:source_image_path": "./assets/images/forgottenhall/prepare_fight.png",
      "march7th:note": "模板是 1920x1080 PC 客户端截图的小块裁剪，手机上必须重新采集，见 RECAPTURE.md"
