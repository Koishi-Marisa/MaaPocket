    "next": [
      "prepare_fight__memory_of_chaos__2"
    ],
    "attach": {
      "march7th:edge": [
        "prepare_fight",
        "memory_of_chaos"
      ],
      "march7th:edge_index": 0,
      "march7th:action_index": 1,
      "march7th:expression": "time.sleep(1)",
      "march7th:kind": "sleep"
    }
  },
  "prepare_fight__memory_of_chaos__2": {
    "recognition": "TemplateMatch",
    "template": "zh_CN/base/confirm.png",
