{
  "Screen_universe_main": {
    "recognition": "TemplateMatch",
    "template": "screen/universe/universe_main.png",
    "threshold": 0.8,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "DoNothing",
    "next": [],
    "attach": {
      "march7th:kind": "screen-anchor",
      "march7th:screen_id": "universe_main",
      "march7th:screen_name": "模拟宇宙-主界面",
      "march7th:source_image_path": "./assets/images/screen/universe/universe_main.png",
      "march7th:note": "模板是 1920x1080 PC 客户端截图的小块裁剪，手机上必须重新采集，见 RECAPTURE.md"
    }
  },
  "universe_main__main__0": {
    "recognition": "DirectHit",
    "action": "ClickKey",
    "key": 111,
    "next": [
      "Screen_main"
    ],
    "attach": {
      "march7th:edge": [
        "universe_main",
        "main"
      ],
      "march7th:edge_index": 0,
      "march7th:action_index": 0,
      "march7th:expression": "auto.press_key('esc')",
      "march7th:kind": "press_key",
      "march7th:upstream_key": "esc",
      "march7th:android_keycode": 111
    }
  },
  "universe_main__universe_expansion__0": {
    "recognition": "TemplateMatch",
    "template": "screen/universe/switch.png",
    "threshold": 0.9,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "Click",
    "target": true,
    "next": [
      "Screen_universe_expansion"
    ],
    "attach": {
      "march7th:edge": [
        "universe_main",
        "universe_expansion"
      ],
      "march7th:edge_index": 1,
      "march7th:action_index": 0,
      "march7th:expression": "auto.click_element('./assets/images/screen/universe/switch.png', 'image', 0.9, 10)",
      "march7th:kind": "click-image",
      "march7th:upstream_threshold": 0.9,
      "march7th:masked_template": false,
      "march7th:max_retries": 10
    },
    "rate_limit": 1000,
    "timeout": 20000
  },
  "Nav_universe_main_from_guide5": {
    "recognition": "TemplateMatch",
    "template": "screen/guide/guide5.png",
    "threshold": 0.8,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "DoNothing",
    "next": [
      "guide5__universe_main__0__UNMAPPED_13"
    ],
    "attach": {
      "march7th:kind": "nav-guard",
      "march7th:note": "在 guide5 上时，沿上游第一条 guide5 -> universe_main 边前进"
    }
  },
  "Nav_universe_main_from_universe_report": {
    "recognition": "TemplateMatch",
    "template": "screen/universe/universe_report.png",
    "threshold": 0.8,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "DoNothing",
    "next": [
      "universe_report__universe_main__0"
    ],
    "attach": {
      "march7th:kind": "nav-guard",
      "march7th:note": "在 universe_report 上时，沿上游第一条 universe_report -> universe_main 边前进"
    }
  },
  "NavTo_universe_main": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "next": [
      "Nav_universe_main_from_guide5",
      "Nav_universe_main_from_universe_report",
      "Screen_universe_main"
    ],
    "attach": {
      "march7th:kind": "nav-router",
      "march7th:target_screen": "universe_main",
      "march7th:predecessors": [
        "guide5",
        "universe_expansion",
        "universe_report"
      ],
      "march7th:note": "DirectHit 进入：先按顺序试探各前驱屏幕守卫节点（TemplateMatch 前驱屏幕锚点），命中则沿那条上游边导航；全部未命中则回退到 Screen_universe_main 锚点——若此时已经在 universe_main 上即成功，否则本节点识别失败（诚实失败，不静默跳过）。只覆盖单跳。"
    }
  }
}
