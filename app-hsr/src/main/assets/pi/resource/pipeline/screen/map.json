{
  "Screen_map": {
    "recognition": "TemplateMatch",
    "template": "screen/map.png",
    "threshold": 0.8,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "DoNothing",
    "next": [],
    "attach": {
      "march7th:kind": "screen-anchor",
      "march7th:screen_id": "map",
      "march7th:screen_name": "地图",
      "march7th:source_image_path": "./assets/images/screen/map.png",
      "march7th:note": "模板是 1920x1080 PC 客户端截图的小块裁剪，手机上必须重新采集，见 RECAPTURE.md"
    }
  },
  "map__main__0": {
    "recognition": "DirectHit",
    "action": "ClickKey",
    "key": 111,
    "next": [
      "Screen_main"
    ],
    "attach": {
      "march7th:edge": [
        "map",
        "main"
      ],
      "march7th:edge_index": 0,
      "march7th:action_index": 0,
      "march7th:expression": "auto.press_key('esc')",
      "march7th:kind": "press_key",
      "march7th:upstream_key": "esc",
      "march7th:android_keycode": 111,
      "march7th:recapture_note": "上游按 esc 打开/关闭暂停菜单（49 次中的 48 次）。Android 客户端没有键盘，esc 不会到达游戏；手机上应改为 Android KEYCODE_BACK(4)，即把 key 由 111 改成 4，或改成点击屏幕上的返回/暂停按钮的模板匹配节点。"
    }
  },
  "Nav_map_from_main": {
    "recognition": "TemplateMatch",
    "template": "screen/main.png",
    "threshold": 0.8,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "DoNothing",
    "next": [
      "main__map__0"
    ],
    "attach": {
      "march7th:kind": "nav-guard",
      "march7th:note": "在 main 上时，沿上游第一条 main -> map 边前进"
    }
  },
  "Nav_map_from_map3d": {
    "recognition": "TemplateMatch",
    "template": "screen/map3d.png",
    "threshold": 0.8,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "DoNothing",
    "next": [
      "map3d__map__0"
    ],
    "attach": {
      "march7th:kind": "nav-guard",
      "march7th:note": "在 map3d 上时，沿上游第一条 map3d -> map 边前进"
    }
  },
  "NavTo_map": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "next": [
      "Nav_map_from_main",
      "Nav_map_from_map3d",
      "Screen_map",
      "NavTo_main",
      "NavTo_map3d"
    ],
    "attach": {
      "march7th:kind": "nav-router",
      "march7th:target_screen": "map",
      "march7th:predecessors": [
        "main",
        "map3d"
      ],
      "march7th:routed_predecessors": [
        "main",
        "map3d"
      ],
      "march7th:note": "DirectHit 进入：先按顺序试探各前驱屏幕守卫节点（TemplateMatch 前驱屏幕锚点），命中则沿那条上游边导航；全部未命中则回退到 Screen_map 锚点——若此时已经在 map 上即成功，否则本节点识别失败（诚实失败，不静默跳过）。只覆盖单跳。"
    }
  }
}
