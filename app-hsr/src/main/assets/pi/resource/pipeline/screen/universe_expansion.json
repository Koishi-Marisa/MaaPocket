{
  "Screen_universe_expansion": {
    "recognition": "TemplateMatch",
    "template": "screen/universe/universe_expansion.png",
    "threshold": 0.8,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "DoNothing",
    "next": [],
    "attach": {
      "march7th:kind": "screen-anchor",
      "march7th:screen_id": "universe_expansion",
      "march7th:screen_name": "模拟宇宙-扩展装置",
      "march7th:source_image_path": "./assets/images/screen/universe/universe_expansion.png",
      "march7th:note": "模板是 1920x1080 PC 客户端截图的小块裁剪，手机上必须重新采集，见 RECAPTURE.md"
    }
  },
  "universe_expansion__main__0": {
    "recognition": "DirectHit",
    "action": "ClickKey",
    "key": 111,
    "next": [
      "Screen_main"
    ],
    "attach": {
      "march7th:edge": [
        "universe_expansion",
        "main"
      ],
      "march7th:edge_index": 0,
      "march7th:action_index": 0,
      "march7th:expression": "auto.press_key('esc')",
      "march7th:kind": "press_key",
      "march7th:upstream_key": "esc",
      "march7th:android_keycode": 111,
      "march7th:recapture_note": "上游按 esc 打开/关闭暂停菜单（49 次中的 48 次）。Android 客户端没有键盘，esc 不会到达游戏；手机上应改为 Android KEYCODE_BACK(4)，即把 key 由 111 改成 4，或改成点击屏幕上的返回/暂停按钮的模板匹配节点。"
    }
  },
  "universe_expansion__universe_main__0": {
    "recognition": "TemplateMatch",
    "template": "screen/universe/switch.png",
    "threshold": 0.9,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "Click",
    "target": true,
    "next": [
      "Screen_universe_main"
    ],
    "attach": {
      "march7th:edge": [
        "universe_expansion",
        "universe_main"
      ],
      "march7th:edge_index": 1,
      "march7th:action_index": 0,
      "march7th:expression": "auto.click_element('./assets/images/screen/universe/switch.png', 'image', 0.9, 10)",
      "march7th:kind": "click-image",
      "march7th:upstream_threshold": 0.9,
      "march7th:masked_template": false,
      "march7th:max_retries": 10
    },
    "rate_limit": 1000,
    "timeout": 20000
  },
  "Nav_universe_expansion_from_universe_main": {
    "recognition": "TemplateMatch",
    "template": "screen/universe/universe_main.png",
    "threshold": 0.8,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "DoNothing",
    "next": [
      "universe_main__universe_expansion__0"
    ],
    "attach": {
      "march7th:kind": "nav-guard",
      "march7th:note": "在 universe_main 上时，沿上游第一条 universe_main -> universe_expansion 边前进"
    }
  },
  "NavTo_universe_expansion": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "next": [
      "Screen_universe_expansion",
      "Nav_universe_expansion_from_universe_main",
      "NavTo_universe_main"
    ],
    "attach": {
      "march7th:kind": "nav-router",
      "march7th:target_screen": "universe_expansion",
      "march7th:predecessors": [
        "universe_main"
      ],
      "march7th:routed_predecessors": [
        "universe_main"
      ],
      "march7th:note": "DirectHit 进入：先按顺序试探各前驱屏幕守卫节点（TemplateMatch 前驱屏幕锚点），命中则沿那条上游边导航；全部未命中则回退到 Screen_universe_expansion 锚点——若此时已经在 universe_expansion 上即成功，否则本节点识别失败（诚实失败，不静默跳过）。只覆盖单跳。"
    }
  }
}
