{
  "Screen_enter_cloud_game": {
    "recognition": "TemplateMatch",
    "template": "screen/cloud/enter_cloud_game.png",
    "threshold": 0.8,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "DoNothing",
    "next": [],
    "attach": {
      "march7th:kind": "screen-anchor",
      "march7th:screen_id": "enter_cloud_game",
      "march7th:screen_name": "进入云游戏",
      "march7th:source_image_path": "./assets/images/screen/cloud/enter_cloud_game.png",
      "march7th:note": "模板是 1920x1080 PC 客户端截图的小块裁剪，手机上必须重新采集，见 RECAPTURE.md"
    }
  },
  "enter_cloud_game__click_enter__0": {
    "recognition": "TemplateMatch",
    "template": "screen/cloud/enter_cloud_game.png",
    "threshold": 0.9,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "Click",
    "target": true,
    "next": [
      "enter_cloud_game__click_enter__1"
    ],
    "attach": {
      "march7th:edge": [
        "enter_cloud_game",
        "click_enter"
      ],
      "march7th:edge_index": 0,
      "march7th:action_index": 0,
      "march7th:expression": "auto.click_element('./assets/images/screen/cloud/enter_cloud_game.png', 'image', 0.9)",
      "march7th:kind": "click-image",
      "march7th:upstream_threshold": 0.9,
      "march7th:masked_template": false
    }
  },
  "enter_cloud_game__click_enter__1": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "post_delay": 6000,
    "next": [
      "Screen_click_enter"
    ],
    "attach": {
      "march7th:edge": [
        "enter_cloud_game",
        "click_enter"
      ],
      "march7th:edge_index": 0,
      "march7th:action_index": 1,
      "march7th:expression": "time.sleep(6)",
      "march7th:kind": "sleep"
    }
  },
  "NavTo_enter_cloud_game": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "next": [
      "Screen_enter_cloud_game"
    ],
    "attach": {
      "march7th:kind": "nav-router",
      "march7th:target_screen": "enter_cloud_game",
      "march7th:predecessors": [],
      "march7th:routed_predecessors": [],
      "march7th:note": "DirectHit 进入：先按顺序试探各前驱屏幕守卫节点（TemplateMatch 前驱屏幕锚点），命中则沿那条上游边导航；全部未命中则回退到 Screen_enter_cloud_game 锚点——若此时已经在 enter_cloud_game 上即成功，否则本节点识别失败（诚实失败，不静默跳过）。只覆盖单跳。"
    }
  }
}
