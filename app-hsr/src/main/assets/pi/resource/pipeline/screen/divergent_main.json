  },
  "NavTo_divergent_main": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "next": [
      "Screen_divergent_main",
      "Nav_divergent_main_from_guide5",
      "Nav_divergent_main_from_divergent_mode_select",
      "NavTo_guide5",
      "NavTo_divergent_mode_select"
    ],
    "attach": {
      "march7th:kind": "nav-router",
      "march7th:target_screen": "divergent_main",
      "march7th:predecessors": [
        "divergent_mode_select",
        "guide5"
      ],
      "march7th:routed_predecessors": [
        "divergent_mode_select",
        "guide5"
      ],
      "march7th:note": "DirectHit 进入：先按顺序试探各前驱屏幕守卫节点（TemplateMatch 前驱屏幕锚点），命中则沿那条上游边导航；全部未命中则回退到 Screen_divergent_main 锚点——若此时已经在 divergent_main 上即成功，否则本节点识别失败（诚实失败，不静默跳过）。只覆盖单跳。"
    }
  }
