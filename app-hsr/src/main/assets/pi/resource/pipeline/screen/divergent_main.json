      0
    ],
    "action": "DoNothing",
    "next": [],
    "attach": {
      "march7th:kind": "screen-anchor",
      "march7th:screen_id": "divergent_main",
      "march7th:screen_name": "差分宇宙-主界面",
      "march7th:source_image_path": "./assets/images/screen/universe/divergent_main.png",
      "march7th:note": "模板是 1920x1080 PC 客户端截图的小块裁剪，手机上必须重新采集，见 RECAPTURE.md"
    }
  },
  "divergent_main__main__0": {
    "recognition": "DirectHit",
    "action": "ClickKey",
    "key": 111,
    "next": [
      "Screen_main"
    ],
    "attach": {
      "march7th:edge": [
        "divergent_main",
        "main"
      ],
      "march7th:edge_index": 0,
      "march7th:action_index": 0,
      "march7th:expression": "auto.press_key('esc')",
      "march7th:kind": "press_key",
      "march7th:upstream_key": "esc",
      "march7th:android_keycode": 111,
      "march7th:recapture_note": "上游按 esc 打开/关闭暂停菜单（49 次中的 48 次）。Android 客户端没有键盘，esc 不会到达游戏；手机上应改为 Android KEYCODE_BACK(4)，即把 key 由 111 改成 4，或改成点击屏幕上的返回/暂停按钮的模板匹配节点。"
    }
  },
  "divergent_main__divergent_mode_select__0": {
    "recognition": "TemplateMatch",
    "template": "screen/universe/homepage.png",
    "threshold": 0.9,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "Click",
    "target": true,
    "next": [
      "divergent_main__divergent_mode_select__1"
    ],
    "attach": {
      "march7th:edge": [
        "divergent_main",
        "divergent_mode_select"
      ],
      "march7th:edge_index": 1,
      "march7th:action_index": 0,
      "march7th:expression": "auto.click_element('./assets/images/screen/universe/homepage.png', 'image', 0.9, 10)",
      "march7th:kind": "click-image",
      "march7th:upstream_threshold": 0.9,
      "march7th:masked_template": false,
      "march7th:max_retries": 10
    },
    "rate_limit": 1000,
    "timeout": 20000
  },
  "divergent_main__divergent_mode_select__1": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "post_delay": 2000,
    "next": [
