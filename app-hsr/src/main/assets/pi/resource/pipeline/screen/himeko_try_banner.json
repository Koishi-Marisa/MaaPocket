      "march7th:source_image_path": "./assets/images/screen/warp/himeko_try_banner.png",
      "march7th:note": "模板是 1920x1080 PC 客户端截图的小块裁剪，手机上必须重新采集，见 RECAPTURE.md"
    }
  },
  "himeko_try_banner__himeko_prepare__0": {
    "recognition": "DirectHit",
    "action": "ClickKey",
    "key": 111,
    "next": [
      "Screen_himeko_prepare"
    ],
    "attach": {
      "march7th:edge": [
        "himeko_try_banner",
        "himeko_prepare"
      ],
      "march7th:edge_index": 0,
      "march7th:action_index": 0,
      "march7th:expression": "auto.press_key('esc')",
      "march7th:kind": "press_key",
      "march7th:upstream_key": "esc",
      "march7th:android_keycode": 111
    }
  },
  "Nav_himeko_try_banner_from_himeko_try": {
    "recognition": "TemplateMatch",
    "template": "screen/warp/himeko_try.png",
    "threshold": 0.8,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "DoNothing",
    "next": [
      "himeko_try__himeko_try_banner__0"
    ],
    "attach": {
      "march7th:kind": "nav-guard",
      "march7th:note": "在 himeko_try 上时，沿上游第一条 himeko_try -> himeko_try_banner 边前进"
    }
  },
  "NavTo_himeko_try_banner": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "next": [
      "Nav_himeko_try_banner_from_himeko_try",
