  "bag_consumables__menu__0": {
    "recognition": "DirectHit",
    "action": "ClickKey",
    "key": 111,
    "next": [
      "Screen_menu"
    ],
    "attach": {
      "march7th:edge": [
        "bag_consumables",
        "menu"
      ],
      "march7th:edge_index": 0,
      "march7th:action_index": 0,
      "march7th:expression": "auto.press_key('esc')",
      "march7th:kind": "press_key",
      "march7th:upstream_key": "esc",
      "march7th:android_keycode": 111,
      "march7th:recapture_note": "上游按 esc 打开/关闭暂停菜单（49 次中的 48 次）。Android 客户端没有键盘，esc 不会到达游戏；手机上应改为 Android KEYCODE_BACK(4)，即把 key 由 111 改成 4，或改成点击屏幕上的返回/暂停按钮的模板匹配节点。"
    }
  },
  "Nav_bag_consumables_from_menu": {
    "recognition": "TemplateMatch",
    "template": "share/menu/more.png",
    "threshold": 0.8,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "DoNothing",
    "next": [
      "menu__bag_consumables__0"
    ],
    "attach": {
      "march7th:kind": "nav-guard",
      "march7th:note": "在 menu 上时，沿上游第一条 menu -> bag_consumables 边前进"
    }
  },
  "NavTo_bag_consumables": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "next": [
      "Nav_bag_consumables_from_menu",
      "Screen_bag_consumables"
    ],
    "attach": {
      "march7th:kind": "nav-router",
      "march7th:target_screen": "bag_consumables",
      "march7th:predecessors": [
        "menu"
      ],
      "march7th:routed_predecessors": [
        "menu"
      ],
      "march7th:note": "DirectHit 进入：先按顺序试探各前驱屏幕守卫节点（TemplateMatch 前驱屏幕锚点），命中则沿那条上游边导航；全部未命中则回退到 Screen_bag_consumables 锚点——若此时已经在 bag_consumables 上即成功，否则本节点识别失败（诚实失败，不静默跳过）。只覆盖单跳。"
    }
  }
}
