      0
    ],
    "action": "DoNothing",
    "next": [],
    "attach": {
      "march7th:kind": "screen-anchor",
      "march7th:screen_id": "bag_consumables",
      "march7th:screen_name": "背包-消耗品",
      "march7th:source_image_path": "./assets/images/screen/bag/bag_consumables.png",
      "march7th:note": "模板是 1920x1080 PC 客户端截图的小块裁剪，手机上必须重新采集，见 RECAPTURE.md"
