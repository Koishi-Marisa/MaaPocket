{
  "Screen_universe_map": {
    "recognition": "TemplateMatch",
    "template": "screen/universe/universe_map.png",
    "threshold": 0.8,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "DoNothing",
    "next": [],
    "attach": {
      "march7th:kind": "screen-anchor",
      "march7th:screen_id": "universe_map",
      "march7th:screen_name": "模拟宇宙-地图",
      "march7th:source_image_path": "./assets/images/screen/universe/universe_map.png",
      "march7th:note": "模板是 1920x1080 PC 客户端截图的小块裁剪，手机上必须重新采集，见 RECAPTURE.md"
    }
  },
  "universe_map__leave_temporarily__0": {
    "recognition": "DirectHit",
    "action": "ClickKey",
    "key": 111,
    "next": [
      "universe_map__leave_temporarily__1"
    ],
    "attach": {
      "march7th:edge": [
        "universe_map",
        "leave_temporarily"
      ],
      "march7th:edge_index": 0,
      "march7th:action_index": 0,
      "march7th:expression": "auto.press_key('esc')",
      "march7th:kind": "press_key",
      "march7th:upstream_key": "esc",
      "march7th:android_keycode": 111
    }
  },
  "universe_map__leave_temporarily__1": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "post_delay": 1000,
    "next": [
      "universe_map__leave_temporarily__2"
    ],
    "attach": {
      "march7th:edge": [
        "universe_map",
        "leave_temporarily"
      ],
      "march7th:edge_index": 0,
      "march7th:action_index": 1,
      "march7th:expression": "time.sleep(1)",
      "march7th:kind": "sleep"
    }
  },
  "universe_map__leave_temporarily__2": {
    "recognition": "DirectHit",
    "action": "ClickKey",
    "key": 111,
    "next": [
      "Screen_leave_temporarily"
    ],
    "attach": {
      "march7th:edge": [
        "universe_map",
        "leave_temporarily"
      ],
      "march7th:edge_index": 0,
      "march7th:action_index": 2,
      "march7th:expression": "auto.press_key('esc')",
      "march7th:kind": "press_key",
      "march7th:upstream_key": "esc",
      "march7th:android_keycode": 111
    }
  },
  "NavTo_universe_map": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "next": [
      "Screen_universe_map"
    ],
    "attach": {
      "march7th:kind": "nav-router",
      "march7th:target_screen": "universe_map",
      "march7th:predecessors": [],
      "march7th:note": "DirectHit 进入：先按顺序试探各前驱屏幕守卫节点（TemplateMatch 前驱屏幕锚点），命中则沿那条上游边导航；全部未命中则回退到 Screen_universe_map 锚点——若此时已经在 universe_map 上即成功，否则本节点识别失败（诚实失败，不静默跳过）。只覆盖单跳。"
    }
  }
}
