{
  "Screen_character_warp": {
    "recognition": "TemplateMatch",
    "template": "screen/warp/character_warp.png",
    "threshold": 0.8,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "DoNothing",
    "next": [],
    "attach": {
      "march7th:kind": "screen-anchor",
      "march7th:screen_id": "character_warp",
      "march7th:screen_name": "角色活动跃迁",
      "march7th:source_image_path": "./assets/images/screen/warp/character_warp.png",
      "march7th:note": "模板是 1920x1080 PC 客户端截图的小块裁剪，手机上必须重新采集，见 RECAPTURE.md"
    }
  },
  "character_warp__menu__0": {
    "recognition": "DirectHit",
    "action": "ClickKey",
    "key": 111,
    "next": [
      "Screen_menu"
    ],
    "attach": {
      "march7th:edge": [
        "character_warp",
        "menu"
      ],
      "march7th:edge_index": 0,
      "march7th:action_index": 0,
      "march7th:expression": "auto.press_key('esc')",
      "march7th:kind": "press_key",
      "march7th:upstream_key": "esc",
      "march7th:android_keycode": 111
    }
  },
  "NavTo_character_warp": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "next": [
      "Screen_character_warp"
    ],
    "attach": {
      "march7th:kind": "nav-router",
      "march7th:target_screen": "character_warp",
      "march7th:predecessors": [],
      "march7th:note": "DirectHit 进入：先按顺序试探各前驱屏幕守卫节点（TemplateMatch 前驱屏幕锚点），命中则沿那条上游边导航；全部未命中则回退到 Screen_character_warp 锚点——若此时已经在 character_warp 上即成功，否则本节点识别失败（诚实失败，不静默跳过）。只覆盖单跳。"
    }
  }
}
