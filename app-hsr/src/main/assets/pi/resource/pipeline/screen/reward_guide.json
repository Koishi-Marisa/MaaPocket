{
  "Screen_reward_guide": {
    "recognition": "TemplateMatch",
    "template": "screen/reward_guide.png",
    "threshold": 0.8,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "DoNothing",
    "next": [],
    "attach": {
      "march7th:kind": "screen-anchor",
      "march7th:screen_id": "reward_guide",
      "march7th:screen_name": "奖励指南",
      "march7th:source_image_path": "./assets/images/screen/reward_guide.png",
      "march7th:note": "模板是 1920x1080 PC 客户端截图的小块裁剪，手机上必须重新采集，见 RECAPTURE.md"
    }
  },
  "reward_guide__activity__0": {
    "recognition": "DirectHit",
    "action": "ClickKey",
    "key": 111,
    "next": [
      "Screen_activity"
    ],
    "attach": {
      "march7th:edge": [
        "reward_guide",
        "activity"
      ],
      "march7th:edge_index": 0,
      "march7th:action_index": 0,
      "march7th:expression": "auto.press_key('esc')",
      "march7th:kind": "press_key",
      "march7th:upstream_key": "esc",
      "march7th:android_keycode": 111,
      "march7th:recapture_note": "上游按 esc 打开/关闭暂停菜单（49 次中的 48 次）。Android 客户端没有键盘，esc 不会到达游戏；手机上应改为 Android KEYCODE_BACK(4)，即把 key 由 111 改成 4，或改成点击屏幕上的返回/暂停按钮的模板匹配节点。"
    }
  },
  "Nav_reward_guide_from_activity": {
    "recognition": "TemplateMatch",
    "template": [
      "screen/activity.png",
      "screen/activity_2.png"
    ],
    "threshold": [
      0.8,
      0.8
    ],
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "DoNothing",
    "next": [
      "activity__reward_guide__0"
    ],
    "attach": {
      "march7th:kind": "nav-guard",
      "march7th:note": "在 activity 上时，沿上游第一条 activity -> reward_guide 边前进"
    }
  },
  "NavTo_reward_guide": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "next": [
      "Nav_reward_guide_from_activity",
      "Screen_reward_guide",
      "NavTo_activity"
    ],
    "attach": {
      "march7th:kind": "nav-router",
      "march7th:target_screen": "reward_guide",
      "march7th:predecessors": [
        "activity"
      ],
      "march7th:routed_predecessors": [
        "activity"
      ],
      "march7th:note": "DirectHit 进入：先按顺序试探各前驱屏幕守卫节点（TemplateMatch 前驱屏幕锚点），命中则沿那条上游边导航；全部未命中则回退到 Screen_reward_guide 锚点——若此时已经在 reward_guide 上即成功，否则本节点识别失败（诚实失败，不静默跳过）。只覆盖单跳。"
    }
  }
}
