{
  "Screen_pass1": {
    "recognition": "TemplateMatch",
    "template": "screen/pass/pass1.png",
    "threshold": 0.8,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "DoNothing",
    "next": [],
    "attach": {
      "march7th:kind": "screen-anchor",
      "march7th:screen_id": "pass1",
      "march7th:screen_name": "无名勋礼-奖励",
      "march7th:source_image_path": "./assets/images/screen/pass/pass1.png",
      "march7th:note": "模板是 1920x1080 PC 客户端截图的小块裁剪，手机上必须重新采集，见 RECAPTURE.md"
    }
  },
  "pass1__menu__0": {
    "recognition": "DirectHit",
    "action": "ClickKey",
    "key": 111,
    "next": [
      "Screen_menu"
    ],
    "attach": {
      "march7th:edge": [
        "pass1",
        "menu"
      ],
      "march7th:edge_index": 0,
      "march7th:action_index": 0,
      "march7th:expression": "auto.press_key('esc')",
      "march7th:kind": "press_key",
      "march7th:upstream_key": "esc",
      "march7th:android_keycode": 111
    }
  },
  "pass1__pass2__0": {
    "recognition": "TemplateMatch",
    "template": "share/reward/pass/enter_pass2.png",
    "threshold": 0.9,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "Click",
    "target": true,
    "next": [
      "Screen_pass2"
    ],
    "attach": {
      "march7th:edge": [
        "pass1",
        "pass2"
      ],
      "march7th:edge_index": 1,
      "march7th:action_index": 0,
      "march7th:expression": "auto.click_element('./assets/images/share/reward/pass/enter_pass2.png', 'image', 0.9)",
      "march7th:kind": "click-image",
      "march7th:upstream_threshold": 0.9,
      "march7th:masked_template": false
    }
  },
  "Nav_pass1_from_menu": {
    "recognition": "TemplateMatch",
    "template": "share/menu/more.png",
    "threshold": 0.8,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "DoNothing",
    "next": [
      "menu__pass1__0"
    ],
    "attach": {
      "march7th:kind": "nav-guard",
      "march7th:note": "在 menu 上时，沿上游第一条 menu -> pass1 边前进"
    }
  },
  "Nav_pass1_from_start_srpass": {
    "recognition": "TemplateMatch",
    "template": "screen/start_srpass.png",
    "threshold": 0.8,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "DoNothing",
    "next": [
      "start_srpass__pass1__0"
    ],
    "attach": {
      "march7th:kind": "nav-guard",
      "march7th:note": "在 start_srpass 上时，沿上游第一条 start_srpass -> pass1 边前进"
    }
  },
  "NavTo_pass1": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "next": [
      "Nav_pass1_from_menu",
      "Nav_pass1_from_start_srpass",
      "Screen_pass1"
    ],
    "attach": {
      "march7th:kind": "nav-router",
      "march7th:target_screen": "pass1",
      "march7th:predecessors": [
        "menu",
        "pass2",
        "start_srpass"
      ],
      "march7th:note": "DirectHit 进入：先按顺序试探各前驱屏幕守卫节点（TemplateMatch 前驱屏幕锚点），命中则沿那条上游边导航；全部未命中则回退到 Screen_pass1 锚点——若此时已经在 pass1 上即成功，否则本节点识别失败（诚实失败，不静默跳过）。只覆盖单跳。"
    }
  }
}
