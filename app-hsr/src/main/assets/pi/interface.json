{
  "interface_version": 2,
  "name": "MaaPocketHSR",
  "version": "0.1.0",
  "label": "崩坏：星穹铁道",
  "title": "MaaPocket · 崩坏：星穹铁道",
  "description": "从 March7thAssistant 迁移而来的屏幕导航图与任务结构（仅导航，不含采集/战斗循环）。模板全部是 PC 客户端截图，手机端需要重新采集。",
  "welcome": "模板尚未在手机端重新采集，识别可能直接失败。请先读 RECAPTURE.md。",
  "license": "GPL-3.0",
  "github": "https://github.com/moesnow/March7thAssistant",
  "controller": [
    {
      "name": "Android",
      "type": "Adb",
      "label": "Android（ADB）",
      "display_long_side": 1920,
      "attach_resource_path": [
        "./resource"
      ]
    }
  ],
  "resource": [
    {
      "name": "国服",
      "label": "国服",
      "path": [
        "./resource"
      ]
    }
  ],
  "languages": {
    "zh_cn": "./resource/locale/zh_cn.json"
  },
