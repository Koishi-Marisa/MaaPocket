{
  "Screen_start_srpass": {
    "recognition": "TemplateMatch",
    "template": "screen/start_srpass.png",
    "threshold": 0.8,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "DoNothing",
    "next": [],
    "attach": {
      "march7th:kind": "screen-anchor",
      "march7th:screen_id": "start_srpass",
      "march7th:screen_name": "开启无名勋礼",
      "march7th:source_image_path": "./assets/images/screen/start_srpass.png",
      "march7th:note": "模板是 1920x1080 PC 客户端截图的小块裁剪，手机上必须重新采集，见 RECAPTURE.md"
    }
  },
  "start_srpass__pass1__0": {
    "recognition": "TemplateMatch",
    "template": "screen/start_srpass.png",
    "threshold": 0.9,
    "roi": [
      0,
      0,
      0,
      0
    ],
    "action": "Click",
    "target": true,
    "next": [
      "Screen_pass1"
    ],
    "attach": {
      "march7th:edge": [
        "start_srpass",
        "pass1"
      ],
      "march7th:edge_index": 0,
      "march7th:action_index": 0,
      "march7th:expression": "auto.click_element('./assets/images/screen/start_srpass.png', 'image', 0.9, 10)",
      "march7th:kind": "click-image",
      "march7th:upstream_threshold": 0.9,
      "march7th:masked_template": false,
      "march7th:max_retries": 10
    },
    "rate_limit": 1000,
    "timeout": 20000
  },
  "NavTo_start_srpass": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "next": [
      "Screen_start_srpass"
    ],
    "attach": {
      "march7th:kind": "nav-router",
      "march7th:target_screen": "start_srpass",
      "march7th:predecessors": [],
      "march7th:routed_predecessors": [],
      "march7th:note": "DirectHit 进入：先按顺序试探各前驱屏幕守卫节点（TemplateMatch 前驱屏幕锚点），命中则沿那条上游边导航；全部未命中则回退到 Screen_start_srpass 锚点——若此时已经在 start_srpass 上即成功，否则本节点识别失败（诚实失败，不静默跳过）。只覆盖单跳。"
    }
  }
}
